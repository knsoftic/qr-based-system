# Production settings for https://pkpay.site (aaPanel)
# On the server:  cp .env.production.example .env   then fill DB_PASSWORD etc.

APP_NAME="PKPay"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pkpay.site

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# aaPanel > Databases > Add database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pkpay
DB_USERNAME=pkpay
DB_PASSWORD=
DB_TIMEZONE=+00:00

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@pkpay.site"
MAIL_FROM_NAME="${APP_NAME}"

# --- Payment gateway ---
GATEWAY_QR_EXPIRY_SECONDS=300
GATEWAY_MIN_AMOUNT=1
GATEWAY_MAX_AMOUNT=500000
GATEWAY_CURRENCY=PKR
GATEWAY_SIGNATURE_TOLERANCE=300
GATEWAY_API_RATE_LIMIT=60
# Never true in production (blocks callbacks to internal/private addresses).
GATEWAY_ALLOW_PRIVATE_CALLBACKS=false

# Only if the site is behind Cloudflare / a proxy: TRUSTED_PROXIES=*
TRUSTED_PROXIES=

# Leave ADMIN_PASSWORD empty; create the admin with:
#   php artisan gateway:create-admin you@pkpay.site
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=admin@pkpay.site
ADMIN_PASSWORD=
